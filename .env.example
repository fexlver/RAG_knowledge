# 阿里云百炼配置
DASHSCOPE_API_KEY=replace-with-your-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
QWEN_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
RERANK_MODEL=qwen3-rerank

# Milvus配置
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=food_safety_chunks_v2

# 检索与生成配置
DENSE_TOP_K=15
LEXICAL_TOP_K=15
FUSION_TOP_K=12
RERANK_TOP_K=5
RRF_K=60
RERANK_MIN_SCORE=0.15
CHUNK_SIZE=500
CHUNK_OVERLAP=100
# PDF 解析器：pymupdf_text（默认，轻量文本层）或 docling（版面+表格结构，CPU 约 4.4 秒/页）
PDF_PARSER=pymupdf_text
MAX_AGENT_STEPS=4
EMBEDDING_BATCH_SIZE=10
CITATION_LIMIT=5
HISTORY_MESSAGE_LIMIT=20

# 本地数据
SQLITE_PATH=data/food_safety_rag.db
UPLOAD_DIR=data/uploads
